# Existing project directory. Windows example: D:/MyProject
# Linux example: /home/you/project
AGENTVISOR_WORKSPACE=./workspace
AGENTVISOR_PORT=8420
# Docker host binding: 127.0.0.1 for this computer, 0.0.0.0 for network access.
AGENTVISOR_BIND_ADDRESS=127.0.0.1
# For network access, list the Docker host IP or hostname used in the browser.
# Example: 192.168.1.100,agentvisor.local
AGENTVISOR_ALLOWED_HOSTS=

# Managed headless LM Studio inside the container (default).
# For an existing server on the host: http://host.docker.internal:1234
AGENTVISOR_MODEL_URL=http://127.0.0.1:1234

# Only if model-server authentication is enabled. Do not commit .env.
AGENTVISOR_MODEL_TOKEN=
